generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum CharacterType {
  PLAYER
  NPC
}

enum PlanetType {
  TERRESTRIAL
  GAS_GIANT
  ICE
  DESERT
  OCEAN
  ASTEROID_BELT
  STATION
}

enum BuildingOwnerType {
  CHARACTER
  FACTION
  CORPORATION
  SYSTEM
}

enum BuildingStatus {
  OPEN
  CLOSED
  DAMAGED
  ABANDONED
  LOCKED_DOWN
}

enum BuildingFunction {
  SHOP
  SAFEHOUSE
  OFFICE
  HUB
  DOCK
  BAR
  CLINIC
  WAREHOUSE
  BLACK_MARKET
  MISSION_BOARD
}

enum FactionMembershipStatus {
  ACTIVE
  EXILED
  BETRAYER
  HONOURED
}

enum CorporationIndustry {
  MINING
  WEAPONS
  TRANSPORT
  CYBERNETICS
  FOOD
  SECURITY
  MEDIA
  ENERGY
  MEDICAL
  LOGISTICS
  BLACK_MARKET
}

enum CorporationStatus {
  GROWING
  STABLE
  DECLINING
  BANKRUPT
}

enum ItemCategory {
  TOOL
  WEAPON
  CLOTHING
  VEHICLE
  CONSUMABLE
  MATERIAL
  QUEST_ITEM
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  ILLEGAL
}

enum ItemOwnerType {
  CHARACTER
  FACTION
  CORPORATION
  BUILDING
  HOUSING
}

enum CharacterHousingStatus {
  ACTIVE
  ENDED
  EVICTED
}

enum EquipmentSlot {
  WEAPON
  OUTFIT
  TOOL
  VEHICLE
}

enum OpportunityKind {
  GIG
  JOB
  QUEST
}

enum OpportunityType {
  DELIVERY
  BOUNTY
  ESCORT
  HACKING
  SMUGGLING
  ASSASSINATION
  INVESTIGATION
  MINING
  TRADING
  DIPLOMACY
  SECURITY
  REPAIR
  STORY
  WORLD
}

enum OpportunityPostedByType {
  CHARACTER
  FACTION
  CORPORATION
  SYSTEM
}

enum OpportunityInstanceStatus {
  AVAILABLE
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum WorldEventScope {
  CHARACTER
  BUILDING
  DISTRICT
  PLANET
  FACTION
  CORPORATION
  WORLD
}

enum WorldEventStatus {
  SCHEDULED
  ACTIVE
  RESOLVED
  CANCELLED
}

enum RelationshipType {
  REPUTATION
  LOYALTY
  HOSTILITY
  TRUST
  EMPLOYMENT
  ALLIANCE
  RIVALRY
  INFLUENCE
  SPONSORSHIP
}

enum ActivityType {
  REGISTERED
  LOGIN
  LOGOUT
  GIG_ACCEPTED
  GIG_COMPLETED
  GIG_FAILED
  JOB_ACCEPTED
  JOB_COMPLETED
  JOB_FAILED
  JOB_HIRED
  JOB_FIRED
  JOB_QUIT
  JOB_STRIKE
  QUEST_STARTED
  QUEST_COMPLETED
  ITEM_BOUGHT
  ITEM_SOLD
  FACTION_JOINED
  BUILDING_ENTERED
  COMBAT_EVENT
  WORLD_EVENT_TRIGGERED
  RELATIONSHIP_CHANGED
  LOCATION_CHANGED
  LEVEL_UP
  STAT_TRAINED
  DECISION_MADE
  DAILY_CLAIMED
  ACHIEVEMENT_EARNED
  HOUSING_RENTED
  HOUSING_ENDED
  RENT_PAID
  ITEM_CRAFTED
}

enum JobEmploymentStatus {
  ACTIVE
  FIRED
  QUIT
}

enum PlayerBountyStatus {
  OPEN
  CLAIMED
  CANCELLED
}

// ==================== MODELS ====================

model Player {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime @default(now())

  character          Character?
  activityLogs       ActivityLog[]
  dailyClaims        DailyClaim[]
  achievementRecords AchievementRecord[]
}

model Character {
  id                String        @id @default(uuid())
  name              String
  type              CharacterType @default(PLAYER)
  playerId          String?       @unique
  player            Player?       @relation(fields: [playerId], references: [id])
  currentPlanetId   String?
  currentPlanet     Planet?       @relation(fields: [currentPlanetId], references: [id])
  currentDistrictId String?
  currentDistrict   District?     @relation(fields: [currentDistrictId], references: [id])
  currentBuildingId String?
  currentBuilding   Building?     @relation(fields: [currentBuildingId], references: [id])
  credits           Float         @default(0)
  health            Int           @default(100)
  maxHealth         Int           @default(100)
  energy            Int           @default(100)
  maxEnergy         Int           @default(100)
  lastEnergyDecayAt DateTime      @default(now())
  wantedLevel       Int           @default(0)
  strength          Int           @default(5)
  agility           Int           @default(5)
  intelligence      Int           @default(5)
  charisma          Int           @default(5)
  hacking           Int           @default(5)
  combat            Int           @default(5)
  stealth           Int           @default(5)
  engineering       Int           @default(5)
  reputation        Int           @default(0)
  xp                Int           @default(0)
  level             Int           @default(1)
  unspentStatPoints Int           @default(0)
  createdAt         DateTime      @default(now())

  factionMemberships     FactionMembership[]
  corporationEmployments CorporationEmployment[]
  opportunityInstances   OpportunityInstance[]
  activityLogs           ActivityLog[]
  stockHoldings          StockHolding[]
  jobEmployments         JobEmployment[]
  duelsStarted           Duel[]                  @relation("DuelAttacker")
  duelsDefended          Duel[]                  @relation("DuelDefender")
  bountiesOnHead         PlayerBounty[]          @relation("BountyTarget")
  bountiesPosted         PlayerBounty[]          @relation("BountyPoster")
  bountiesClaimed        PlayerBounty[]          @relation("BountyClaimer")
  housings               CharacterHousing[]
}

model SolarSystem {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  planets Planet[]
}

model Planet {
  id            String      @id @default(uuid())
  solarSystemId String
  solarSystem   SolarSystem @relation(fields: [solarSystemId], references: [id])
  name          String      @unique
  description   String?
  planetType    PlanetType  @default(TERRESTRIAL)
  dangerLevel   Int         @default(1)
  lawLevel      Int         @default(5)
  economyLevel  Int         @default(5)

  districts  District[]
  characters Character[]
}

model District {
  id                   String   @id @default(uuid())
  planetId             String
  planet               Planet   @relation(fields: [planetId], references: [id])
  name                 String
  description          String?
  controllingFactionId String?
  controllingFaction   Faction? @relation(fields: [controllingFactionId], references: [id])
  dangerLevel          Int      @default(1)
  lawLevel             Int      @default(5)
  economyLevel         Int      @default(5)
  mapWidth             Int      @default(20)
  mapHeight            Int      @default(20)
  mapTiles             Json     @default("[]")

  buildings  Building[]
  characters Character[]
}

model Building {
  id            String            @id @default(uuid())
  districtId    String
  district      District          @relation(fields: [districtId], references: [id])
  name          String
  description   String?
  ownerType     BuildingOwnerType @default(SYSTEM)
  ownerId       String?
  functionality Json              @default("[]")
  status        BuildingStatus    @default(OPEN)
  gridX         Int?
  gridY         Int?
  gridWidth     Int               @default(1)
  gridHeight    Int               @default(1)
  gridZ         Float             @default(1.4)

  characters          Character[]
  factionHeadquarters Faction[]          @relation("FactionHQ")
  corporationHQs      Corporation[]      @relation("CorporationHQ")
  housings            CharacterHousing[]
}

model Faction {
  id                     String    @id @default(uuid())
  name                   String    @unique
  description            String?
  ideology               String?
  headquartersBuildingId String?
  headquartersBuilding   Building? @relation("FactionHQ", fields: [headquartersBuildingId], references: [id])
  treasury               Float     @default(0)
  influence              Int       @default(0)

  memberships FactionMembership[]
  districts   District[]
}

model FactionMembership {
  id          String                  @id @default(uuid())
  factionId   String
  faction     Faction                 @relation(fields: [factionId], references: [id])
  characterId String
  character   Character               @relation(fields: [characterId], references: [id])
  rankName    String                  @default("Member")
  loyalty     Int                     @default(50)
  reputation  Int                     @default(0)
  status      FactionMembershipStatus @default(ACTIVE)
  joinedAt    DateTime                @default(now())

  @@unique([factionId, characterId])
}

model Corporation {
  id                     String              @id @default(uuid())
  name                   String              @unique
  description            String?
  industry               CorporationIndustry
  headquartersBuildingId String?
  headquartersBuilding   Building?           @relation("CorporationHQ", fields: [headquartersBuildingId], references: [id])
  cash                   Float               @default(0)
  debt                   Float               @default(0)
  revenue                Float               @default(0)
  riskOfBankruptcy       Float               @default(0)
  politicalInfluence     Int                 @default(0)
  status                 CorporationStatus   @default(STABLE)
  stockTicker            String?
  stockPrice             Float?
  stockVolatility        Float?

  employments   CorporationEmployment[]
  stockHoldings StockHolding[]
  priceHistory  StockPriceHistory[]
}

model StockHolding {
  id            String   @id @default(uuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id])
  corporationId String
  corporation   Corporation @relation(fields: [corporationId], references: [id])
  shares        Int      @default(0)
  averagePrice  Float    @default(0)
  acquiredAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([characterId, corporationId])
}

model CorporationEmployment {
  id            String      @id @default(uuid())
  corporationId String
  corporation   Corporation @relation(fields: [corporationId], references: [id])
  characterId   String
  character     Character   @relation(fields: [characterId], references: [id])
  role          String
  salary        Float       @default(0)
  rank          String      @default("Employee")
  status        String      @default("ACTIVE")
  startedAt     DateTime    @default(now())

  @@unique([corporationId, characterId])
}

model ItemDefinition {
  id           String       @id @default(uuid())
  name         String       @unique
  description  String?
  category     ItemCategory
  rarity       ItemRarity   @default(COMMON)
  baseValue    Float        @default(0)
  weight       Float        @default(0)
  effects      Json?
  requirements Json?
  weaponData   Json?
  clothingData Json?
  toolData     Json?
  vehicleData  Json?

  instances ItemInstance[]
}

model ItemInstance {
  id               String         @id @default(uuid())
  itemDefinitionId String
  itemDefinition   ItemDefinition @relation(fields: [itemDefinitionId], references: [id])
  ownerType        ItemOwnerType
  ownerId          String
  condition        Int            @default(100)
  customName       String?
  modifiers        Json?
  equippedSlot     EquipmentSlot?
  createdAt        DateTime       @default(now())

  @@index([ownerType, ownerId, equippedSlot])
}

model OpportunityDefinition {
  id                String                  @id @default(uuid())
  title             String
  description       String?
  acceptedDescription String?
  kind              OpportunityKind
  postedByType      OpportunityPostedByType @default(SYSTEM)
  postedById        String?
  type              OpportunityType
  requirements      Json                    @default("[]")
  durationMinutes   Int?
  difficulty        Int                     @default(1)
  rewards           Json                    @default("[]")
  risks             Json                    @default("[]")
  timelineEvents    Json                    @default("[]")
  possibleEventIds  Json                    @default("[]")
  repeatability     Json?
  questData         Json?
  startsAvailableAt DateTime?
  endsAvailableAt   DateTime?
  createdAt         DateTime                @default(now())

  instances     OpportunityInstance[]
  employments   JobEmployment[]
}

model JobEmployment {
  id                    String                @id @default(uuid())
  characterId           String
  character             Character             @relation(fields: [characterId], references: [id])
  opportunityId         String
  opportunity           OpportunityDefinition @relation(fields: [opportunityId], references: [id])
  hiredAt               DateTime              @default(now())
  lastShiftAt           DateTime              @default(now())
  strikes               Int                   @default(0)
  status                JobEmploymentStatus   @default(ACTIVE)
  cadenceHours          Int                   @default(24)
  totalShiftsCompleted  Int                   @default(0)
  totalCreditsEarned    Float                 @default(0)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@unique([characterId, opportunityId])
}

model OpportunityInstance {
  id           String                    @id @default(uuid())
  definitionId String
  definition   OpportunityDefinition     @relation(fields: [definitionId], references: [id])
  characterId  String
  character    Character                 @relation(fields: [characterId], references: [id])
  status       OpportunityInstanceStatus @default(IN_PROGRESS)
  startedAt    DateTime                  @default(now())
  completesAt  DateTime
  completedAt  DateTime?
  progress     Json?
  rolledEvents Json?
  outcome      Json?
}

model WorldEvent {
  id               String           @id @default(uuid())
  title            String
  description      String?
  scope            WorldEventScope
  triggeredByType  String?
  triggeredById    String?
  affectedEntities Json             @default("[]")
  requirements     Json             @default("[]")
  effects          Json             @default("[]")
  startsAt         DateTime?
  endsAt           DateTime?
  status           WorldEventStatus @default(SCHEDULED)
}

model Relationship {
  id               String           @id @default(uuid())
  sourceType       String
  sourceId         String
  targetType       String
  targetId         String
  relationshipType RelationshipType
  value            Float            @default(0)
  metadata         Json?
  updatedAt        DateTime         @updatedAt

  @@unique([sourceType, sourceId, targetType, targetId, relationshipType])
}

model ActivityLog {
  id              String       @id @default(uuid())
  playerId        String?
  player          Player?      @relation(fields: [playerId], references: [id])
  characterId     String?
  character       Character?   @relation(fields: [characterId], references: [id])
  type            ActivityType
  message         String
  relatedEntities Json?
  metadata        Json?
  createdAt       DateTime     @default(now())
}

model Duel {
  id                 String    @id @default(uuid())
  attackerId         String
  attacker           Character @relation("DuelAttacker", fields: [attackerId], references: [id])
  defenderId         String
  defender           Character @relation("DuelDefender", fields: [defenderId], references: [id])
  districtId         String?
  wagerCredits       Float     @default(0)
  attackerRoll       Int
  attackerTotal      Float
  defenderRoll       Int
  defenderTotal      Float
  winnerId           String
  creditsTransferred Float     @default(0)
  createdAt          DateTime  @default(now())

  @@index([attackerId, createdAt])
  @@index([defenderId, createdAt])
}

model PlayerBounty {
  id          String             @id @default(uuid())
  targetId    String
  target      Character          @relation("BountyTarget", fields: [targetId], references: [id])
  postedById  String
  postedBy    Character          @relation("BountyPoster", fields: [postedById], references: [id])
  amount      Float
  reason      String?
  status      PlayerBountyStatus @default(OPEN)
  claimedById String?
  claimedBy   Character?         @relation("BountyClaimer", fields: [claimedById], references: [id])
  claimedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
  @@index([targetId, status])
}

model StockPriceHistory {
  id            String      @id @default(uuid())
  corporationId String
  corporation   Corporation @relation(fields: [corporationId], references: [id])
  price         Float
  recordedAt    DateTime    @default(now())

  @@index([corporationId, recordedAt])
}

model CharacterHousing {
  id            String                 @id @default(uuid())
  characterId   String
  character     Character              @relation(fields: [characterId], references: [id])
  buildingId    String
  building      Building               @relation(fields: [buildingId], references: [id])
  rentPerDay    Float
  nextRentDueAt DateTime
  status        CharacterHousingStatus @default(ACTIVE)
  totalRentPaid Float                  @default(0)
  createdAt     DateTime               @default(now())
  endedAt       DateTime?

  @@index([characterId, status])
  @@index([status, nextRentDueAt])
}

model DailyClaim {
  id             String   @id @default(uuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id])
  streak         Int      @default(1)
  creditsAwarded Float    @default(0)
  xpAwarded      Int      @default(0)
  claimedAt      DateTime @default(now())

  @@index([playerId, claimedAt])
}

model AchievementRecord {
  id             String   @id @default(uuid())
  playerId       String
  player         Player   @relation(fields: [playerId], references: [id])
  achievementId  String
  creditsAwarded Float    @default(0)
  xpAwarded      Int      @default(0)
  claimedAt      DateTime @default(now())

  @@unique([playerId, achievementId])
}

model SimulationTick {
  id          String   @id @default(uuid())
  processedAt DateTime @default(now())
  summary     Json
  results     Json?
  randomSeed  Float?
  createdAt   DateTime @default(now())
}
