{
  "name": "hibaro-5",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:run": "bash ./scripts/setup-and-run.sh",
    "setup:stop": "bash ./scripts/stop-and-clean.sh",
    "build:packages": "npm run build --workspace=packages/game-rules && npm run build --workspace=packages/game-types && npm run build --workspace=packages/platform-sdk && npm run build --workspace=packages/validation",
    "dev": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "test": "npm run test --workspace=apps/api && npm run test --workspace=packages/game-rules",
    "prisma:migrate": "npx prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=prisma/schema.prisma",
    "db:seed": "npx ts-node --project prisma/tsconfig.seed.json prisma/seed.ts",
    "lint": "eslint \"{apps,packages}/**/*.ts\" --fix --ignore-pattern \"**/next-env.d.ts\"",
    "format": "prettier --write \"{apps,packages,prisma}/**/*.ts\""
  },
  "overrides": {
    "next": {
      "postcss": ">=8.5.10"
    },
    "postcss": ">=8.5.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
