DATABASE_URL="postgresql://heliora:heliora@localhost:5432/heliora"
REDIS_URL="redis://localhost:6379"
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d

# Admin token: when set, admin CRUD endpoints (POST/PATCH/DELETE on
# opportunities, locations, factions, corporations, world-events,
# items/definitions) require an x-admin-token header. Leave blank for
# local dev to allow unauthenticated admin writes.
ADMIN_TOKEN=

# Auto-tick: in-process scheduler that resolves opportunities and advances the world
SIMULATION_AUTO_TICK=true
SIMULATION_TICK_INTERVAL_MS=30000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
